# ===== 应用 =====
APP_DEBUG=true

# ===== JWT =====
# 用 `openssl rand -base64 48` 生成一个随机串替换
JWT_SECRET_KEY=your-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 管理后台（/api/v1/admin/*）登录 token 有效期（分钟），后台无 refresh 流程，默认 2 天
ADMIN_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2880

# ===== 超级管理员（首次启动自动创建） =====
SUPER_ADMIN_EMAIL=admin@matrix365.com
SUPER_ADMIN_PASSWORD=your-admin-password

# ===== MySQL =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=matrix365

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=1

# ===== Milvus =====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Elasticsearch =====
ES_HOST=localhost
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=your-es-password

# ===== MinIO =====
MINIO_ENDPOINT=localhost:9100
# 需与 docker-compose.milvus.yml 中 MinIO 的 MINIO_ROOT_USER / MINIO_ROOT_PASSWORD 一致
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9100

# ===== LLM 供应商 =====
# 微软 Azure
AZURE_OPENAI_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_MODELS=gpt-5.4-mini,gpt-5.4-nano,gpt-5.4

# 火山引擎
VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VOLCENGINE_API_KEY=your-volcengine-key
VOLCENGINE_MODELS=doubao-seed-2-0-pro-260215,doubao-seed-2-0-lite-260215,doubao-seed-2-0-mini-260215

# 阿里云
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_API_KEY=your-aliyun-key
ALIYUN_MODELS=qwen3.6-flash,qwen3.7-plus,qwen3.7-max

# 默认 LLM
DEFAULT_LLM_PROVIDER=azure
DEFAULT_LLM_MODEL=gpt-5.4-mini

#   azure(gpt-5.4) → reasoning_effort；doubao → thinking.enabled；qwen → enable_thinking(仅流式)
ARTICLE_THINKING_ENABLED=true

# ===== 生图/生视频 =====
# 火山引擎 Ark
ARK_API_KEY=your-ark-key
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-260128
DOUBAO_VIDEO_MODEL=doubao-seedance-2-0-260128

# 腾讯云 VOD
TENCENT_SECRET_ID=your-tencent-id
TENCENT_SECRET_KEY=your-tencent-key
# VOD 子应用 ID（整数，控制台「应用管理」中查看；0 = 未配置）
TENCENT_VOD_SUB_APP_ID=0

# Azure gpt-image-2 生图（复用上面的 AZURE_OPENAI_API_KEY）
# URL 模板：https://{host}/openai/deployments/{deployment-name}/images/{action}?api-version={version}
# 调整 api-version 直接改 URL 末尾即可，无需独立配置项
AZURE_IMAGE_GENERATIONS_URL=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2025-04-01-preview
AZURE_IMAGE_EDITS_URL=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/edits?api-version=2025-04-01-preview
AZURE_IMAGE_MODEL=gpt-image-2

# 轮询配置
VIDEO_POLL_INTERVAL=5
VIDEO_POLL_TIMEOUT=1800

# ===== OCR（PaddleOCR PP-StructureV3） =====
# 单独用 docker-compose.paddleocr.yml 启动 PaddleOCR Serving 后开启
OCR_SERVICE_URL=http://localhost:8866
OCR_ENABLED=true
OCR_TIMEOUT=120
# OCR 失败时是否降级到 PyMuPDF（仅对 PDF 有效）
OCR_FALLBACK_TO_PYMUPDF=true

# ===== Pandoc 文档转 Markdown =====
# 对 DOCX/PPTX/HTML/EPUB/RTF/ODT 等格式优先用 Pandoc 转 GFM
# 需要宿主机 / 容器内安装 pandoc：sudo apt-get install pandoc
PANDOC_ENABLED=true

# ===== PPTX 图片 OCR =====
# 开启后解析 PPTX 时会并发 OCR 幻灯片中的嵌入图片
# 依赖 OCR_ENABLED=true 且 PaddleOCR 服务可用，否则自动跳过
PPTX_IMAGE_OCR_ENABLED=true

# ===== 模型加载策略 =====
# false = 懒加载（默认，启动快，首次文档处理时一次性等待）
# true  = 启动时并发预加载 BGE-M3 + wtpsplit + CLIP（首次请求零等待）
MODEL_PRELOAD_ENABLED=false

# ===== 混合检索策略 =====
# 合并模式: rrf=倒数排名融合（推荐，排名稳定）| weighted=归一化加权求和
HYBRID_MERGE_MODE=rrf
RRF_K=60
# 向量召回原始分下限（BGE-M3 余弦相似度），低于此值直接过滤（减少重排候选量）
VECTOR_SCORE_THRESHOLD=0.40
# 重排序后分数下限，低于此值不返回（0 = 不过滤）
# 送入重排序的最大候选数（RRF/加权排序后截断，防大数据量卡死）
RERANKER_TOP_N=20
RERANKER_SCORE_THRESHOLD=0.05

# ===== 重排序功能 =====
# false = 关闭重排序，混合检索直接返回 RRF 合并结果（节省显存）
# true  = 开启重排序，使用 BGE-Reranker-v2-m3 对召回结果精排
RERANKER_ENABLED=false

# ===== 图片语义检索 =====
# CLIP 余弦相似度下限，低于此值不返回（0 = 不过滤）
IMAGE_SCORE_THRESHOLD=0.20

# ===== WhisperX 语音转录 =====
WHISPERX_URL=http://your-whisperx-host:8000/v1/audio/transcriptions
WHISPERX_TIMEOUT=300
# 中文专用模型
WHISPERX_MODEL_ZH=flateon/Belle-whisper-large-v3-turbo-zh-ct2
# 通用模型（其余语言 / 自动检测）；若转录服务未部署通用模型，可设为与中文模型相同
WHISPERX_MODEL_DEFAULT=deepdml/faster-whisper-large-v3-turbo-ct2
# 中文专用模型是否输出繁体（true=自动转简体）
WHISPERX_ZH_IS_TRADITIONAL=false

# ===== Index-TTS 文字转语音 =====
INDEX_TTS_URL=http://your-index-tts-host:8001/tts_url
# TTS 服务端上的参考音频路径
INDEX_REFERENCE_AUDIO=reference.wav

# ===== 国内分发：推量发 (TLF) 网关 =====
TLF_BASE_URL=http://localhost:8041/api/sdk/v1
TLF_APP_ID=app_xxxxxxxxxxxxxxxx
TLF_APP_KEY=tlf_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TLF_HTTP_TIMEOUT=65
# 「推量发新建租户」时分配给本租户的 webhook_secret（推量发转发事件回主 backend 时用此 secret 验签）
TLF_WEBHOOK_SECRET=
TLF_REDIS_PREFIX=tlf:
TLF_WEBHOOK_MAX_AGE=300
# 数据采集每日触发时间（24h 制，本地时区）
TLF_METRICS_DAILY_HOUR=2
TLF_METRICS_DAILY_MINUTE=0

# ===== 梦网国际短信 =====
# false 时跳过真实发送，仅日志打印验证码（本地开发用）
SMS_ENABLED=true
SMS_PROVIDER_USERID=xxx
SMS_PROVIDER_PWD=xxx
SMS_SINGLE_URL=http://sms.umsapi.int-montnets.com:6651/sms/v2/std/message
SMS_BATCH_URL=http://sms.umsapi.int-montnets.com:6651/sms/v2/std/batchmessage
# 短信签名前缀，需与短信平台已报备的签名一致
SMS_SIGNATURE=【中巨量科技】
SMS_HTTP_TIMEOUT=8
# 验证码有效期（秒）
SMS_VERIFY_CODE_TTL=300
# 同号 60s 最多 1 次
SMS_RATE_PHONE_60S=1
# 同号 1h 最多 5 次
SMS_RATE_PHONE_HOUR=5
# 同号 24h 最多 10 次
SMS_RATE_PHONE_DAY=10
# 同 IP 1h 最多 20 次
SMS_RATE_IP_HOUR=20
# 验证码错误尝试上限，超出锁定 15 分钟
SMS_VERIFY_MAX_FAIL=5
SMS_VERIFY_LOCK_SECONDS=900

# ===== HuggingFace 离线模式 =====
# 模型已下载到本地时，设置以下三项可完全屏蔽对 HuggingFace 的网络检查，避免启动超时。
# 开发环境已经通过bstart.sh脚本默认注入环境变量
# 关闭 huggingface_hub 的所有网络请求（最关键）
HF_HUB_OFFLINE=1
# 关闭 transformers 库的网络请求
TRANSFORMERS_OFFLINE=1
# 关闭 datasets 库的网络请求
HF_DATASETS_OFFLINE=1
# 如果模型不在默认缓存目录（~/.cache/huggingface/hub/），
# HF_HOME=/path/to/your/models

# ===== 通联支付 AllinPay =====
# 沙箱: https://syb-test.allinpay.com     生产: https://vsp.allinpay.com
ALLINPAY_BASE_URL=https://syb-test.allinpay.com
# 商户号（15位）
ALLINPAY_CUSID=
# 应用 ID（8位）
ALLINPAY_APPID=
# 商户 RSA 私钥 PKCS#8 PEM（单行 base64，不含 -----BEGIN/END----- 头尾）
ALLINPAY_PRIVATE_KEY=
# 通联平台 RSA 公钥 PEM（单行 base64，用于验证回调签名）
ALLINPAY_PUBLIC_KEY=
# 异步回调地址，必须公网可达 HTTPS
ALLINPAY_NOTIFY_URL=https://example.com/api/v1/webhooks/allinpay
# 回调来源 IP 白名单（逗号分隔，留空不校验）
ALLINPAY_CALLBACK_IP_WHITELIST=

# ===== 邮件 / SMTP（管理后台：发票开具后发邮件给收票邮箱）=====
# false 时跳过真实发送，仅打日志（本地开发用）
EMAIL_ENABLED=true
SMTP_HOST=smtp.example.com
# 465=SSL / 587=STARTTLS
SMTP_PORT=465
# SMTP 登录账号（同时作为发件人地址）
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=推量牛
SMTP_TIMEOUT=15
