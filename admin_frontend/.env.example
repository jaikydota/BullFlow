# Vite 环境变量必须以 VITE_ 开头才会注入到浏览器
# ============================================================
# Admin API 地址
# 默认走相对路径 /api/v1（由 vite dev proxy 或 nginx 反代到 backend 的 /api/v1/admin/*）；
# 如需指定绝对地址（独立部署 / CDN 场景），覆盖以下变量。
VITE_ADMIN_API_BASE_URL=/api/v1

# ============================================================
# C 端前台站点 URL
# Sidebar 底部「返回前台」按钮跳转目标。
# - 单域部署：保持 /
# - 双域部署（admin.example.com 与 app.example.com 分开）：
#     VITE_FRONTEND_URL=https://app.example.com
VITE_FRONTEND_URL=/
