# ====== JWT（tlf 自有密钥，自己签发自己校验）======
# 用 `openssl rand -base64 48` 生成一个，写到这里
JWT_SECRET_KEY=your-tlf-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=2880

# ====== 首次启动自动 seed 第一个 super_admin（admin_users 表为空时触发）======
TLF_ADMIN_INIT_EMAIL=admin@tlf.local
TLF_ADMIN_INIT_PASSWORD=your-admin-password
TLF_ADMIN_INIT_NAME=推量发管理员

# ====== 独立数据库（首次启动前需手动创建）======
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=matrix365_tlf

# ====== Redis（webhook 防重放 / auth-op 状态缓存）======
REDIS_URL=redis://localhost:6379/3
TLF_REDIS_PREFIX=tlf:
# 扫码授权进度（auth-op）在 Redis 的存活时长（秒），需覆盖扫码窗口；过期后接入方改用 GET /accounts 兜底
AUTH_OP_STATE_TTL_SECONDS=1800
# 扫码授权超时（秒）：超时仍无上游结果，/auth/status 返回 status=timeout；须 <= AUTH_OP_STATE_TTL_SECONDS
AUTH_OP_TIMEOUT_SECONDS=600
# 发布任务超时（秒）：自生效起点（立即发布=创建时间；定时发布=pre_pub_time）起未到终态即判超时
PUBLISH_TASK_TIMEOUT_SECONDS=3600

# ====== 灵径 lapi.cc 真实凭据（仅此处保存）======
LAPI_BASE_URL=https://app.lapi.cc
LAPI_APP_ID=
LAPI_SECRET=
LAPI_WEBHOOK_SECRET=
LAPI_HTTP_TIMEOUT=60
LAPI_WEBHOOK_MAX_AGE=300
# 调用灵径接口的日志单段最大字符数（参数 / 响应超长时截断），0 = 不截断
LAPI_LOG_MAX_CHARS=1000

# ====== Composio（海外平台 OAuth + 发帖；managed 只需 API key，无各平台 OAuth、无代理）======
COMPOSIO_API_KEY=
# 留空使用 SDK 内置 production host = https://backend.composio.dev
COMPOSIO_BASE_URL=
# OAuth 授权完成后浏览器回跳页（tlf 网关自带的「授权完成」提示页，须公网可达；本地调试可换 http://localhost:8041/...）
COMPOSIO_CALLBACK_URL=https://tlf-365.chuhaibang.com/api/sdk/v1/auth/composio/callback
COMPOSIO_WEBHOOK_SECRET=
# 显式登记各 toolkit 的 auth config id，形如 twitter=ac_xxx,linkedin=ac_yyy（toolkit 小写）。
# 自建 OAuth app 的平台（如 X/Twitter）必须在此登记；ac_id 须与 COMPOSIO_API_KEY 属于同一个 project
COMPOSIO_AUTH_CONFIG_IDS=

# ====== 代理健康检查（周期检测 + 不健康自动换）======
PROXY_HEALTH_CHECK_ENABLED=true
# 本机巡检周期（秒）
PROXY_HEALTH_CHECK_INTERVAL=1200
# 经代理访问的探测目标
PROXY_HEALTH_TARGET=https://www.baidu.com
# 单代理探测超时（秒）
PROXY_HEALTH_TIMEOUT=8.0
# 出口延迟超过此值（毫秒）判为 slow
PROXY_SLOW_MS=3000
# 本机巡检连续失败达此次数才判 dead（防抖动）
PROXY_DEAD_FAIL_THRESHOLD=3
# 灵径侧用该代理连续失败（超时/网络异常）达此次数 → 禁用 + 迁移
PROXY_UPSTREAM_FAIL_THRESHOLD=2
# 并发探测数
PROXY_HEALTH_CONCURRENCY=8
# 同一终端用户在同一 IP、同一平台的账号上限，达到后新账号改分配到同区域另一个 IP；0=不限
PROXY_STICKY_MAX_PER_PLATFORM=15

# ====== 批量同步账号（/accounts/sync-batch）======
# 单次最多同步账号数
SYNC_BATCH_MAX_ACCOUNTS=20
# 批量同步的并发度
SYNC_BATCH_CONCURRENCY=5

# ====== 不活跃账号自动回收（上游按账号按天计费）======
# 超过 N 天「未使用」（无发布/取分类/风控操作，也未重新扫码授权）的灵径账号：
# 自动在灵径侧 revoke 停止扣费 + 本地标 expired（下游账号仍显示、登录态为掉线，重新扫码即恢复，acc_xxx 不变），
# 并给绑定租户推 accountStatus(expired) webhook。注意「使用」不含登录态轮询检查与触发指标采集
# （均为下游定时任务常态，若计入会让账号被每日续命）。0=禁用
INACTIVE_ACCOUNT_REVOKE_DAYS=14
# 后台巡检周期（小时）
INACTIVE_REVOKE_INTERVAL_HOURS=12

# ====== 子租户 webhook 转发 ======
WEBHOOK_FORWARD_MAX_RETRIES=3
WEBHOOK_FORWARD_TIMEOUT=10
WEBHOOK_FORWARD_BACKOFF_SECONDS=1,3,10

# ====== CORS ======
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5391,http://127.0.0.1:5391,http://localhost:8040,http://127.0.0.1:8040
CORS_EXTRA_ORIGINS=
CORS_ALLOW_LOCALHOST_REGEX=true
CORS_ALLOW_PRIVATE_LAN_REGEX=true
